# Neon — neon.tech → skapa projekt → Connection Details → "Pooled connection"
# (drizzle-orm/neon-http fungerar bäst med den pooled/HTTP-anslutningssträngen)
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Auth.js — generera med `npx auth secret` eller `openssl rand -base64 33`
AUTH_SECRET=

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials →
# "OAuth client ID" (Web application). Redirect URI:
# http://localhost:3000/api/auth/callback/google (lägg till din produktions-URL också)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend — resend.com → API Keys (gratis nivå: 3 000 mejl/månad, inget kort krävs)
# Används för inloggning via magisk länk.
AUTH_RESEND_KEY=
# Avsändaradress — måste vara från en domän du verifierat hos Resend
# (i sandboxläge går det bra med "onboarding@resend.dev" för att testa lokalt).
AUTH_RESEND_FROM=onboarding@resend.dev

# TMDB — themoviedb.org → Settings → API → "API Key (v3 auth)"
# Used for film/serie search, details and per-country streaming availability.
TMDB_API_KEY=

# RAWG — rawg.io/apidocs → Get API key
# Used for spel search, details and platforms.
RAWG_API_KEY=

# Google Books — optional. Search works without a key (lower, shared quota).
# Get one at console.cloud.google.com if you hit rate limits.
GOOGLE_BOOKS_API_KEY=

# BoardGameGeek XML API2 — BGG kräver numera (2025/2026) ett registrerat
# API-token, till skillnad från tidigare. Registrera en app på
# boardgamegeek.com/applications, generera ett token under "Tokens" bredvid
# din app, och klistra in det här. Utan detta ger brädspelssök 401.
BGG_API_TOKEN=
